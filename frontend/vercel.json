{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/cron/collect", "schedule": "0 21 * * *" }
  ],
  "rewrites": [
    { "source": "/t/:code", "destination": "/api/track?code=:code" },
    { "source": "/api/t/:code", "destination": "/api/track?code=:code" },
    { "source": "/api/contents/:id/schedule", "destination": "/api/contents/schedule?id=:id" },
    { "source": "/api/platforms/:platform/disconnect", "destination": "/api/platforms?platform=:platform&action=disconnect" },
    { "source": "/api/posts/metrics", "destination": "/api/posts?metrics=1" },
    { "source": "/api/upload/:contentId", "destination": "/api/upload?contentId=:contentId" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
